# ==================== 部署配置 ====================
# 宿主机 Nginx 配置目录，Docker Compose 会只读挂载到容器。
NGINX_CONFIG_DIRECTORY=/etc/nginx/conf.d
# 宿主机 Nginx 日志目录，Docker Compose 会读写挂载到容器。
NGINX_LOG_DIRECTORY=./logs/nginx

# ==================== 本地 Docker Compose 配置 ====================
# docker-compose-local.yml 中 Nginx 对外暴露的前端端口，同时代理 /api/v1 接口。
WEB_PORT=5550
# 发卡网站地址，留空时购买积分页面显示未配置提示。
NEXT_PUBLIC_CREDIT_STORE_URL=
# 前端页脚展示的ICP备案号，留空时不显示备案链接。
NEXT_PUBLIC_ICP_RECORD_NUMBER=京ICP备2025118934号
# 前端展示的项目 GitHub 仓库地址，留空时不显示入口。
NEXT_PUBLIC_GITHUB_URL=https://github.com/Swayingleaves/novanova-studio

# ==================== 应用与服务配置 ====================
# 应用签发 Bearer Token 使用的密钥，生产环境必须设置为至少 32 字节的高强度随机值。
APP_SECRET_KEY=
# Bearer Token 有效时间，单位为小时。
TOKEN_EXPIRE_HOURS=24
# 可信反向代理的 IP 或 CIDR，多个使用英文逗号分隔（如 172.18.0.1,10.0.0.0/8）。
# 容器内看到的代理源地址是 Docker bridge 网关而非 127.0.0.1（端口映射会被 NAT）：默认网段通常为 172.18.0.1，可用 docker network inspect <网络名> 查看 Gateway，建议按网段配 CIDR（如 172.18.0.0/16）防网关漂移。
# 未配置时不会信任 X-Forwarded-For，接口记录与登录限流只能看到代理地址。
TRUSTED_PROXY_ADDRESSES=
# 允许跨域访问 API 的精确来源，多个来源使用英文逗号分隔。
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5555,http://127.0.0.1:5555,https://www.novanovastudio.cn
# Java 服务监听端口。
SERVER_PORT=8080
# 服务端日志保存目录。
LOG_DIR=./logs
# 服务端根日志级别，例如 INFO、DEBUG、WARN。
LOG_LEVEL=INFO
# Docker 容器和 Java 日志使用的时区，默认采用中国标准时间。
TZ=Asia/Shanghai

# ==================== AI 系统提示词配置 ====================
# 以下变量为可选覆盖项。Docker 默认读取只读挂载的 /app/config/prompts；本地默认读取项目根目录下的 server/config/prompts。
# AI_SYSTEM_PROMPT_OPTIMIZATION_IMAGE_FILE=file:/app/config/prompts/optimization-image.md
# AI_SYSTEM_PROMPT_OPTIMIZATION_VIDEO_FILE=file:/app/config/prompts/optimization-video.md
# AI_SYSTEM_PROMPT_AGENT_MAIN_FILE=file:/app/config/prompts/agent-main.md
# AI_SYSTEM_PROMPT_AGENT_RECOVERY_FILE=file:/app/config/prompts/agent-recovery.md
# AI_SYSTEM_PROMPT_AGENT_IMAGE_FILE=file:/app/config/prompts/agent-image.md
# AI_SYSTEM_PROMPT_AGENT_VIDEO_FILE=file:/app/config/prompts/agent-video.md
# AI_SYSTEM_PROMPT_AGENT_CANVAS_FILE=file:/app/config/prompts/agent-canvas.md
# AI_SYSTEM_PROMPT_AGENT_STORYBOARD_FILE=file:/app/config/prompts/agent-storyboard.md

# 是否将第三方返回的 HTTP 图片结果转存到默认对象存储；开启后转存失败会使生成任务失败。
AI_IMAGE_HTTP_RESULT_UPLOAD_TO_OBJECT_STORAGE=false
# 异步 AI 任务状态轮询间隔，服务端渠道/内部等待/视频合成恢复和前端状态查询共享，单位为秒，必须大于 0。
AI_TASK_POLLING_INTERVAL_SECONDS=5

# ==================== PostgreSQL 配置 ====================
# PostgreSQL 服务地址。
POSTGRES_HOST=127.0.0.1
# PostgreSQL 服务端口。
POSTGRES_PORT=5432
# PostgreSQL 登录用户名。
POSTGRES_USERNAME=postgres
# PostgreSQL 登录密码。
POSTGRES_PASSWORD=123456
# PostgreSQL 数据库名称。
POSTGRES_DATABASE=novanova_studio
# 自动创建目标数据库前连接的 PostgreSQL 管理数据库。
POSTGRES_ADMINISTRATOR_DATABASE=postgres

# ==================== Redis 配置 ====================
# Redis 服务地址。
REDIS_HOST=127.0.0.1
# Redis 服务端口。
REDIS_PORT=6379
# Redis 登录密码，未启用认证时留空。
REDIS_PASSWORD=
# Redis 逻辑数据库编号。
REDIS_DATABASE=0

# ==================== 初始管理员配置 ====================
# 系统初始管理员邮箱。只在不存在同邮箱账号时创建，已有账号不会被覆盖。
ADMIN_INITIAL_EMAIL=admin@admin.com
# 系统初始管理员密码。必须至少 8 个字符，生产环境必须通过环境变量覆盖默认密码。
ADMIN_INITIAL_PASSWORD=novanovastudio@pwss
# 系统初始管理员昵称。
ADMIN_INITIAL_NICKNAME=admin

# ==================== 邮件服务配置 ====================
# 发送邮箱验证码使用的 SMTP 服务地址。
EMAIL_SMTP_HOST=
# SMTP 服务端口，SSL 通常使用 465。
EMAIL_SMTP_PORT=465
# SMTP 登录用户名。
EMAIL_SMTP_USERNAME=
# SMTP 登录密码或授权码。
EMAIL_SMTP_PASSWORD=
# 验证码邮件的发件人邮箱。
EMAIL_SMTP_FROM=

# ==================== linux.do OAuth2 配置 ====================
# 是否启用 linux.do OAuth2 登录。
OAUTH2_LINUX_DO_ENABLED=false
# linux.do OAuth2 应用客户端 ID。
OAUTH2_LINUX_DO_CLIENT_ID=
# linux.do OAuth2 应用客户端密钥。
OAUTH2_LINUX_DO_CLIENT_SECRET=
# linux.do OAuth2 完整回调地址，必须与平台应用配置完全一致。
OAUTH2_LINUX_DO_REDIRECT_URI=http://localhost:5555/api/v1/auth/oauth/callback/linuxDo

# ==================== Google OAuth2 配置 ====================
# 是否启用 Google OAuth2 登录。
OAUTH2_GOOGLE_ENABLED=false
# Google OAuth2 Web 应用客户端 ID。
OAUTH2_GOOGLE_CLIENT_ID=
# Google OAuth2 Web 应用客户端密钥。
OAUTH2_GOOGLE_CLIENT_SECRET=
# Google OAuth2 完整回调地址，必须与 Google Cloud Console 中的授权重定向 URI 完全一致。
OAUTH2_GOOGLE_REDIRECT_URI=http://localhost:5555/api/v1/auth/oauth/callback/google
